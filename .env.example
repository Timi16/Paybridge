# PayBridge environment. Copy to .env and fill in. Every variable in apps/api/src/config/env.ts
# must be listed here (a test checks it).

NODE_ENV=development
PORT=4200
# Interface to listen on. Keep 127.0.0.1 when a reverse proxy (Caddy) runs on the same machine.
HOST=127.0.0.1
LOG_LEVEL=info

# Postgres. Locally: `pnpm db:up` (docker-compose.dev.yml). On the server: `docker compose up -d`
# (compose.yaml), which also needs this line with the same password as in DATABASE_URL:
# POSTGRES_PASSWORD=
DATABASE_URL=postgresql://paybridge:paybridge@localhost:5436/paybridge

# Stellar Testnet only: the API and worker refuse to boot with any other passphrase.
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Origin of the web app: CORS and the CSRF check. No trailing slash.
WEB_ORIGIN=http://localhost:3000

# 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: outgoing email for password reset links, e.g. smtps://user:pass@smtp.example.com:465
# Without it: in development the email is printed in the API log; in production resets are off.
SMTP_URL=
MAIL_FROM=PayBridge <no-reply@paybridge.local>
# New accounts confirm their email with a 6-digit code. auto = on when SMTP_URL is set; on; off.
EMAIL_VERIFICATION=auto

# Seconds a built payroll batch waits for the company's Freighter signature before it can no longer land.
BATCH_WINDOW_SECONDS=300

# Optional: Telegram alerts from the worker (lag, testnet reset, stale heartbeat)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
