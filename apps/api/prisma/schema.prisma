generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  businessName      String
  emailVerifiedAt   DateTime? // set once the company entered the code emailed at sign-up
  emailVerification EmailVerification?
  notifyPaid        Boolean            @default(true) // email when a run finishes paid
  notifyProblems    Boolean            @default(true) // email when a run finishes with failed lines
  closedAt          DateTime?
  runCounter        Int                @default(0) // last PayrollRun.number handed out
  createdAt         DateTime           @default(now())
  devices           TrustedDevice[]
  passwordResets    PasswordReset[]
  sessions          Session[]
  apiKeys           ApiKey[]
  wallets           Wallet[]
  challenges        WalletChallenge[]
  groups            Group[]
  employees         Employee[]
  runs              PayrollRun[]
}

model Session {
  id         String   @id // HMAC-SHA256 of the cookie token
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) // refreshed at most every 5 minutes
  ip         String?
  userAgent  String?

  @@index([companyId])
}

// A browser that has logged in successfully before. It is exempt from the account-wide
// login lock, so an attacker hammering a company's email cannot lock the company out.
model TrustedDevice {
  id         String   @id // HMAC-SHA256 of the device cookie token
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([companyId])
}

// The six-digit code emailed at sign-up. One live code per company; only its keyed hash is stored.
model EmailVerification {
  companyId String   @id
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0) // wrong guesses against this code
  sentAt    DateTime @default(now())
}

// One-hour, single-use password reset link. Only the keyed hash of the token is stored.
model PasswordReset {
  id        String    @id // HMAC-SHA256 of the token in the emailed link
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, createdAt])
}

// Failed-login counters, shared by every API instance.
model LoginThrottle {
  key         String   @id // "p:<email>|<ip>" or "e:<email>"
  failures    Int
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

// Fixed-window counters for rate limits that must hold across API instances.
model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime

  @@index([resetAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  prefix     String // e.g. "pb_test_9f2a"
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId])
}

// A Stellar account the company pays payroll from. PayBridge never holds its key: the company
// signs each batch in Freighter.
model Wallet {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  address       String // base G address
  label         String?
  verifiedAt    DateTime? // optional SEP-53 ownership proof
  accountExists Boolean      @default(false)
  trustlines    Json         @default("[]") // [{ code, issuer, limit, balance, buyingLiabilities, sellingLiabilities, authorized }]
  nativeBalance String? // XLM balance as Horizon reports it, cached for display
  checkedAt     DateTime?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  runs          PayrollRun[]

  @@index([companyId])
  @@index([address])
}

model WalletChallenge {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  address   String
  message   String // "PayBridge wallet verification\nCompany: …\nWallet: …\nNonce: …\nExpires: …"
  expiresAt DateTime // 10 minutes
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, address])
}

model Group {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())
  employees Employee[]

  @@unique([companyId, name])
}

model Employee {
  id                   String        @id @default(cuid())
  companyId            String
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String
  email                String?
  role                 String?
  walletAddress        String // base G address; one active employee per (company, wallet)
  defaultAmountStroops BigInt
  groupId              String?
  group                Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  archivedAt           DateTime?
  checkReason          String? // null = can receive USDC; else ACCOUNT_NOT_FOUND | NO_TRUSTLINE | NOT_AUTHORIZED | TRUSTLINE_LIMIT_TOO_LOW
  checkedAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  items                PayrollItem[]

  @@index([companyId, createdAt])
  @@index([companyId, walletAddress])
}

enum RunStatus {
  DRAFT
  PAYING
  PAID
  PARTIAL
  FAILED
  CANCELLED
}

enum ItemStatus {
  PENDING
  SENDING
  PAID
  FAILED
  CANCELLED
}

enum BatchStatus {
  AWAITING_SIGNATURE
  SUBMITTED
  CONFIRMED
  FAILED
  EXPIRED
}

model PayrollRun {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number        Int // per company: 1, 2, 3…
  name          String
  payDate       DateTime?      @db.Date
  walletId      String
  wallet        Wallet         @relation(fields: [walletId], references: [id])
  walletAddress String // snapshot of the funding wallet
  assetCode     String
  assetIssuer   String
  status        RunStatus      @default(DRAFT)
  startedAt     DateTime?
  finishedAt    DateTime?
  notifiedAt    DateTime? // the notifier has emailed about the finish
  createdVia    String // "dashboard" | "api"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         PayrollItem[]
  batches       PayrollBatch[]
  events        PayrollEvent[]

  @@unique([companyId, number])
  @@index([companyId, createdAt])
  @@index([status])
}

model PayrollItem {
  id            String        @id @default(cuid())
  runId         String
  run           PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyId     String
  employeeId    String?
  employee      Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  position      Int // order on the run, 1-based
  name          String // snapshot
  walletAddress String // snapshot
  amountStroops BigInt
  status        ItemStatus    @default(PENDING)
  failureCode   String?
  failureDetail String? // raw Stellar result code, when there is one
  batchId       String?
  batch         PayrollBatch? @relation(fields: [batchId], references: [id])
  opIndex       Int?
  txHash        String?
  ledger        Int?
  paidAt        DateTime? // ledger close time
  attempts      Int           @default(0) // batches this line has been put in
  createdAt     DateTime      @default(now())

  @@unique([runId, employeeId])
  @@index([runId, position])
  @@index([companyId, status])
  @@index([batchId])
}

model PayrollBatch {
  id           String        @id @default(cuid())
  runId        String
  run          PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyId    String
  number       Int // per run
  txHash       String        @unique // hash of the unsigned transaction; signing does not change it
  envelopeXdr  String
  signedXdr    String?
  sequence     String
  maxTime      DateTime // timebound: cannot land in a ledger that closes after this
  opCount      Int
  totalStroops BigInt
  status       BatchStatus   @default(AWAITING_SIGNATURE)
  resultCode   String? // tx_failed, tx_bad_seq, … on failure
  ledger       Int?
  closedAt     DateTime?
  submittedAt  DateTime?
  settledAt    DateTime?
  createdAt    DateTime      @default(now())
  items        PayrollItem[]

  @@unique([runId, number])
  @@index([status])
}

// Append-only audit trail of a run.
model PayrollEvent {
  id        String     @id @default(cuid())
  runId     String
  run       PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId    String?
  batchId   String?
  type      String // "created" | "started" | "excluded" | "batch_built" | "submitted" | "confirmed" | "batch_failed" | "expired" | "line_failed" | "retried" | "cancelled" | "finished"
  message   String
  actor     String // "company" | "api" | "system"
  createdAt DateTime   @default(now())

  @@index([runId, createdAt])
}
